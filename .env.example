# ============================================================
# Vajra Core - Phase 0.5 Foundation Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------
APP_ENV=development
APP_NAME=Vajra Core - Network Security Auditor
APP_VERSION=0.5.0
APP_DEBUG=true

# ------------------------------------------------------------
# Database Configuration - PostgreSQL (Production)
# ------------------------------------------------------------
# PostgreSQL connection (for production mode)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vajra_core
POSTGRES_USER=vajra
POSTGRES_PASSWORD=vajra_dev_password

# Database URL (will be constructed from above, or override directly)
DATABASE_URL=postgresql://vajra:vajra_dev_password@localhost:5432/vajra_core

# SQLite fallback (for local development without Docker)
SQLITE_DATABASE_URL=sqlite:///./data/sih26155.db

# Use PostgreSQL (true) or SQLite (false)
USE_POSTGRES=false

# ------------------------------------------------------------
# Redis Configuration - Job Queue & Caching
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=vajra_redis_password
REDIS_DB=0
REDIS_URL=redis://:vajra_redis_password@localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://:vajra_redis_password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:vajra_redis_password@localhost:6379/1

# ------------------------------------------------------------
# MinIO Configuration - Object Storage (S3-compatible)
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Buckets
MINIO_BUCKET_CONFIGS=vajra-configs
MINIO_BUCKET_REPORTS=vajra-reports
MINIO_BUCKET_ARTIFACTS=vajra-artifacts
MINIO_DEFAULT_BUCKETS=vajra-configs,vajra-reports,vajra-artifacts

# Use MinIO (true) or filesystem (false)
USE_MINIO=false

# ------------------------------------------------------------
# File Storage Configuration (Filesystem fallback)
# ------------------------------------------------------------
UPLOAD_DIR=./data/uploads
SANITIZED_DIR=./data/sanitized
NORMALIZED_DIR=./data/normalized
REPORTS_DIR=./data/reports
STORAGE_BASE_PATH=./data

# ------------------------------------------------------------
# Keycloak Configuration - Authentication (Optional)
# ------------------------------------------------------------
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vajra
KEYCLOAK_CLIENT_ID=vajra-core
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_PORT=8080
KEYCLOAK_DB=keycloak

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------
# AI Model Configuration
# ------------------------------------------------------------
AI_MODEL=all-MiniLM-L6-v2
AI_HIGH_THRESHOLD=0.85
AI_REVIEW_THRESHOLD=0.60
AI_EMBEDDING_DIMENSION=384

# ------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.cfg,.conf,.txt,.json,.yaml,.yml
SECRET_KEY=change-this-to-a-random-secret-key-in-production
HASH_ALGORITHM=sha256

# Secret Masking Patterns
MASK_PASSWORDS=true
MASK_SNMP_STRINGS=true
MASK_API_KEYS=true

# ------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5555
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# Flower Monitoring
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:flower_password

# ------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/vajra.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------
# Framework Data Configuration
# ------------------------------------------------------------
FRAMEWORKS_DIR=./data/frameworks
CIS_BENCHMARKS_DIR=./data/frameworks/cis
NIST_DIR=./data/frameworks/nist
STIG_DIR=./data/frameworks/stig

# ------------------------------------------------------------
# Compliance Rules Configuration
# ------------------------------------------------------------
RULES_FILE=./app/compliance/rules.yaml
CUSTOM_RULES_DIR=./data/custom_rules

# ------------------------------------------------------------
# Development/Testing Configuration
# ------------------------------------------------------------
TESTING=false
TEST_DATABASE_URL=sqlite:///./data/test_sih26155.db
GENERATE_TEST_DATA=false

# ------------------------------------------------------------
# Performance Configuration
# ------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
FEATURE_AI_LEARNING=true
FEATURE_PDF_REPORTS=true
FEATURE_ASYNC_PROCESSING=false
FEATURE_AUTHENTICATION=false
FEATURE_BULK_UPLOAD=true
FEATURE_CONFIGURATION_VERSIONING=false

# ------------------------------------------------------------
# Data Provenance Configuration
# ------------------------------------------------------------
TRACK_PROVENANCE=true
GENERATE_FILE_HASHES=true
DATA_MANIFEST_PATH=./data/manifests/manifest.json
