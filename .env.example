# Application Environment
APP_ENV=development
APP_NAME=SIH26155 Network Security Auditor
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite:///./data/sih26155.db

# File Storage
UPLOAD_DIR=./data/uploads
SANITIZED_DIR=./data/sanitized
NORMALIZED_DIR=./data/normalized
REPORTS_DIR=./data/reports

# AI Model Configuration
AI_MODEL=all-MiniLM-L6-v2
AI_HIGH_THRESHOLD=0.85
AI_REVIEW_THRESHOLD=0.60

# Security
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.cfg,.conf,.txt,.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Service Configuration
# Gmail SMTP Settings (Gmail App Password required)
# Steps to generate Gmail App Password:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password and paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=tatva-noreply@vajra-security.com
FROM_NAME=VAJRA Tatva System

# Email recipient for admin notifications
ADMIN_EMAIL=admin@yourcompany.com

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
