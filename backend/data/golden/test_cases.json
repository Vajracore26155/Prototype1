{
  "golden_test_suite_version": "1.0",
  "created": "2026-09-16",
  "description": "Golden test dataset with known expected outcomes for Vajra Core regression testing",
  "test_cases": [
    {
      "test_case_id": "GOLD-001",
      "name": "Cisco IOS - Fully Compliant SSH Configuration",
      "category": "positive",
      "config_file": "positive/cisco_ssh_compliant.cfg",
      "vendor": "Cisco",
      "expected_outcomes": {
        "vendor_detection": {
          "detected_vendor": "Cisco",
          "confidence_threshold": 0.8,
          "confidence_operator": ">="
        },
        "parsing": {
          "should_parse_successfully": true,
          "expected_parser": "CiscoParser"
        },
        "normalization": {
          "should_normalize": true,
          "expected_fields": {
            "remote_access.ssh_enabled": true,
            "remote_access.ssh_version": 2,
            "remote_access.telnet_enabled": false,
            "management.http_enabled": false,
            "management.https_enabled": true,
            "authentication.enable_secret_configured": true,
            "authentication.password_encryption": true,
            "authentication.local_authentication": true,
            "logging.enabled": true,
            "access_control.timeout_configured": true
          }
        },
        "compliance": {
          "expected_findings": [
            {"rule_id": "NET-001", "status": "PASS", "severity": "HIGH"},
            {"rule_id": "NET-002", "status": "PASS", "severity": "HIGH"},
            {"rule_id": "NET-003", "status": "PASS", "severity": "MEDIUM"},
            {"rule_id": "NET-004", "status": "PASS", "severity": "HIGH"},
            {"rule_id": "NET-005", "status": "PASS", "severity": "MEDIUM"},
            {"rule_id": "NET-006", "status": "PASS", "severity": "MEDIUM"},
            {"rule_id": "NET-007", "status": "PASS", "severity": "HIGH"},
            {"rule_id": "NET-008", "status": "PASS", "severity": "LOW"},
            {"rule_id": "NET-009", "status": "PASS", "severity": "MEDIUM"},
            {"rule_id": "NET-010", "status": "PASS", "severity": "LOW"}
          ],
          "expected_compliance_score": 100.0,
          "expected_risk_level": "LOW",
          "expected_passed_count": 10,
          "expected_failed_count": 0,
          "expected_warning_count": 0
        },
        "evidence": {
          "should_have_evidence": true,
          "sample_evidence_checks": [
            {
              "field": "remote_access.ssh_version",
              "expected_evidence_text_contains": "ip ssh version 2"
            },
            {
              "field": "remote_access.telnet_enabled",
              "expected_evidence_text_contains": "transport input ssh"
            }
          ]
        }
      }
    },
    {
      "test_case_id": "GOLD-002",
      "name": "Cisco IOS - Insecure Telnet Configuration",
      "category": "negative",
      "config_file": "negative/cisco_telnet_insecure.cfg",
      "vendor": "Cisco",
      "expected_outcomes": {
        "vendor_detection": {
          "detected_vendor": "Cisco",
          "confidence_threshold": 0.8,
          "confidence_operator": ">="
        },
        "parsing": {
          "should_parse_successfully": true,
          "expected_parser": "CiscoParser"
        },
        "normalization": {
          "should_normalize": true,
          "expected_fields": {
            "remote_access.telnet_enabled": true,
            "management.http_enabled": true,
            "authentication.enable_secret_configured": false,
            "authentication.password_encryption": false
          }
        },
        "compliance": {
          "expected_findings": [
            {"rule_id": "NET-001", "status": "FAIL", "severity": "HIGH"},
            {"rule_id": "NET-004", "status": "FAIL", "severity": "HIGH"},
            {"rule_id": "NET-007", "status": "FAIL", "severity": "HIGH"},
            {"rule_id": "NET-008", "status": "FAIL", "severity": "LOW"}
          ],
          "expected_compliance_score_operator": "<",
          "expected_compliance_score": 50.0,
          "expected_risk_level": "HIGH",
          "expected_failed_count_operator": ">=",
          "expected_failed_count": 3
        },
        "remediation": {
          "should_generate_remediation": true,
          "expected_remediation_commands": [
            "no ip http server",
            "ip ssh version 2",
            "transport input ssh"
          ]
        }
      }
    },
