# ============================================================
# VAJRA CORE - Production Environment Configuration
# ============================================================

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL for production (recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/vajra_core

# SQLite for development/testing
# DATABASE_URL=sqlite:///./data/sih26155.db

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================
# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72

# ============================================================
# LLM/AI CONFIGURATION
# ============================================================
# OpenAI API
OPENAI_API_KEY=sk-...

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API
GOOGLE_API_KEY=...

# LLM Cost Limits
USER_MONTHLY_LIMIT=10.0
ORG_MONTHLY_LIMIT=1000.0
SINGLE_REQUEST_LIMIT=1.0

# ============================================================
# REDIS (Optional but Recommended for Production)
# ============================================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ============================================================
# CELERY (Async Task Queue)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================
# STORAGE
# ============================================================
# Storage backend: filesystem or minio
STORAGE_BACKEND=filesystem

# Filesystem storage
STORAGE_PATH=./data

# MinIO/S3 storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vajra-configs
MINIO_SECURE=false

# ============================================================
# API CONFIGURATION
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/vajra.log

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# EMAIL (For Scheduled Reports)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=VAJRA Core <noreply@vajracore.local>

# ============================================================
# MONITORING & TELEMETRY
# ============================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_AI_FEATURES=true
ENABLE_BULK_UPLOAD=true
ENABLE_REMEDIATION=true
ENABLE_DRIFT_DETECTION=true

# ============================================================
# SECURITY
# ============================================================
# Session timeout (minutes)
SESSION_TIMEOUT=30

# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=50

# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# ============================================================
# DEVELOPMENT/DEBUG (Set to false in production!)
# ============================================================
DEBUG=false
RELOAD=false
